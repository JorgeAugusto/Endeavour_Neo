<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.jorge.reis</groupId>
    <artifactId>endeavour-neo</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Endeavour Neo</name>
    <description>A desktop application shell in Swing, laid out like an IDE.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <main.class>br.com.jorge.reis.endeavourneo.Launcher</main.class>

        <junit.version>5.10.3</junit.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            A APARENCIA. O FlatLaf e o look-and-feel derivado do IntelliJ:
            plano, sem gradiente, com tema claro e escuro. E a peca que faz um
            programa Swing deixar de parecer um programa Swing de 2005.

            A classe Aparencia o carrega POR REFLEXAO, e nao por import. Isso
            nao e preciosismo: sem o jar a aplicacao sobe igual, com o
            look-and-feel do sistema, em vez de morrer com NoClassDefFoundError.
            O FlatLaf fica sendo um acrescimo que melhora, e nao um requisito
            que quebra o arranque de quem clonar o projeto sem rede.
        -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.5.4</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <!--
                            The suite gets a home of its own, under target.

                            Without this the tests write the reader's real
                            settings and workspace: opening a window in a test
                            runs rememberCharts, which replaces their list of
                            open charts with whatever the test opened. Every run
                            of the suite did that. Settings has documented the
                            need for this seam since it was written; what was
                            missing was somebody setting it.
                        -->
                        <endeavourneo.home>${project.build.directory}/test-home</endeavourneo.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
