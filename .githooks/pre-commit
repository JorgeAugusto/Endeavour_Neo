#!/bin/sh
#
# Runs the test suite before letting a commit through.
#
# This is the local stand-in for continuous integration: with no remote, the
# only moment where broken code can be stopped from entering history is here.
#
# INSTALL (once per clone):
#
#     git config core.hooksPath .githooks
#
# The hook is versioned precisely for that reason -- inside .git/hooks it does
# not travel with the repository and is lost on the next clone.
#
# TO SKIP, when you know what you are doing:
#
#     git commit --no-verify
#
# Skipping is legitimate for work in progress on your own branch. It is not
# legitimate on master.
#
# FINDING THE TOOLS
#
# A hook that only works when Maven and a JDK are on the PATH is a hook that
# does not run, and one that does not run is worse than none: it is believed
# in. On a machine where the IDE carries its own JDK and Maven -- which is the
# normal case on Windows -- neither is on the PATH, and the honest answer is to
# go and look for them rather than to give up.
#
# To pin them by hand instead, write .githooks/env (not versioned):
#
#     JAVA_HOME="/c/some/jdk"
#     MVN="/c/some/maven/bin/mvn"

set -e

# A commit that touches no code does not need the suite. Without this, editing
# a .md would cost half a minute.
if ! git diff --cached --name-only | grep -qE '^src/.*\.(java|properties)$'; then
    echo "pre-commit: no source in this commit, skipping the tests"
    exit 0
fi

if [ -f .githooks/env ]; then
    . ./.githooks/env
fi

# ----------------------------------------------------------------- the JDK

# The release the project compiles against. Anything older cannot build it, so
# there is no point picking it up.
NEEDED=$(sed -n 's/.*<maven\.compiler\.release>\([0-9]*\)<.*/\1/p' pom.xml | head -1)
NEEDED=${NEEDED:-17}

usable() {
    [ -x "$1/bin/javac" ] || return 1

    have=$("$1/bin/javac" -version 2>&1 | sed -n 's/javac \([0-9]*\).*/\1/p')

    [ -n "$have" ] && [ "$have" -ge "$NEEDED" ]
}

if [ -z "$JAVA_HOME" ] || ! usable "$JAVA_HOME"; then
    JAVA_HOME=""

    # The JetBrains runtimes first: on a machine with no JDK installed system
    # wide, they are usually the only ones present, and they are complete.
    for candidate in \
        "$LOCALAPPDATA/JetBrains"/*/jbr \
        "$HOME/AppData/Local/JetBrains"/*/jbr \
        "/c/Program Files/Eclipse Adoptium"/jdk* \
        "/c/Program Files/Java"/jdk*; do

        if usable "$candidate"; then
            JAVA_HOME="$candidate"
        fi
    done
fi

if [ -z "$JAVA_HOME" ]; then
    echo "pre-commit: no JDK $NEEDED or newer found; see .githooks/pre-commit"
    exit 1
fi

export JAVA_HOME

# -------------------------------------------------------------- and Maven

if [ -z "$MVN" ]; then
    if [ -x ./mvnw ]; then
        MVN=./mvnw
    elif command -v mvn >/dev/null 2>&1; then
        MVN=mvn
    else
        # Where the Maven wrapper unpacks what it downloads. The IDE puts it
        # there and then uses it without ever touching the PATH.
        for candidate in "$HOME"/.m2/wrapper/dists/*/*/*/bin/mvn; do
            if [ -x "$candidate" ]; then
                MVN="$candidate"
            fi
        done
    fi
fi

if [ -z "$MVN" ]; then
    echo "pre-commit: no Maven found; see .githooks/pre-commit"
    exit 1
fi

echo "pre-commit: running the suite with $("$JAVA_HOME/bin/javac" -version 2>&1) ..."

if ! "$MVN" -q -o test; then
    echo
    echo "pre-commit: commit blocked -- the suite is failing"
    exit 1
fi

exit 0
